# Copy this file to .env.local and fill in the blanks.
# .env.local is gitignored. Never commit real keys.

# --- Groq -------------------------------------------------------------------
# Create a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Both fall back to these values if unset.
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_RETRIES=2

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API. Run lib/supabase/migrations/001_initial.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server side only. This key bypasses row level security, so it must never be
# exposed to the browser. Note the missing NEXT_PUBLIC_ prefix: that is what
# keeps Next.js from inlining it into the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Misc -------------------------------------------------------------------
# Origin allowed to call the API. Defaults to the local dev server.
CORS_ORIGIN=http://localhost:3000
